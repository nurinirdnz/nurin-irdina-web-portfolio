# Dependencies and generated reports
node_modules/
coverage/
*.log
npm-debug.log*

# Local configuration and secrets
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.pfx

# Runtime data (may contain contact messages and session hashes)
backend/data/

# Original resume contains private contact/reference details (address, phone,
# referee emails). Kept outside frontend/ so express.static can never serve it;
# resume.html is the redacted public copy. Do not move this back into frontend/.
private/

# Local scratch tooling, not part of the app (e.g. one-off scripts with their
# own node_modules) — keep it off disk from git's perspective regardless of size.
tmp/

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
