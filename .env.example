PORT=3000
APP_ORIGIN=http://localhost:3000
# Run npm run setup to generate .env with a random password.
ADMIN_PASSWORD=
DATABASE_PATH=backend/data/portfolio.sqlite
NODE_ENV=development
# Use 1 only when exactly one trusted reverse proxy fronts this app.
TRUST_PROXY=0

# Optional: email notification for new contact-form messages, sent via Brevo's HTTPS
# API (not SMTP — needed since some hosts block outbound SMTP ports).
# Leave any of these blank to disable — messages still save to the database either way.
# 1. Create a free account at brevo.com
# 2. Settings -> Senders, Domains & Dedicated IPs -> Senders -> add BREVO_SENDER_EMAIL,
#    then verify it via the confirmation email Brevo sends to that address.
# 3. Settings -> SMTP & API -> API Keys -> generate a new key -> BREVO_API_KEY.
NOTIFY_EMAIL=
BREVO_SENDER_EMAIL=
BREVO_API_KEY=
