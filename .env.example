PORT=3000
APP_ORIGIN=http://localhost:3000
# Run npm run setup to generate .env with a random password.
ADMIN_PASSWORD=
DATABASE_PATH=backend/data/portfolio.sqlite
NODE_ENV=development
# Use 1 only when exactly one trusted reverse proxy fronts this app.
TRUST_PROXY=0

# Optional: email notification for new contact-form messages.
# Leave any of these blank to disable — messages still save to the database either way.
# GMAIL_USER and GMAIL_APP_PASSWORD authenticate the sending Gmail account (generate an
# App Password at https://myaccount.google.com/apppasswords — needs 2-Step Verification on).
NOTIFY_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
